logging {
  level = "info"
}

// ---------- Browser side: Grafana Faro ----------
faro.receiver "integrations_app_agent_receiver" {
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    cors_allowed_origins     = ["http://localhost"]
    api_key                  = "my_super_app_key"
    max_allowed_payload_size = "10MiB"

    rate_limiting {
      rate = 100
    }
  }

  output {
    logs = [loki.process.logs_process_client.receiver]
    traces = [otelcol.processor.batch.default.input]
  }
}

// ---------- Backend side: Express API (OTLP) ----------
otelcol.receiver.otlp "backend" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// ---------- Shared pipeline ----------
otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

loki.process "logs_process_client" {
  forward_to = [loki.write.logs_write_client.receiver]

  stage.logfmt {
    mapping = {
      kind         = "",
      service_name = "",
      app          = "",
      event_name   = "",
    }
  }

  stage.labels {
    values = {
      kind         = "kind",
      service_name = "service_name",
      app          = "app",
    }
  }

  stage.structured_metadata {
    values = {
      event_name             = "",
    }
  }
}

loki.write "logs_write_client" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}